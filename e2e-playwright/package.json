{
  "name": "sige-e2e-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Testes E2E e de API do SIGE.games com Playwright",
  "type": "module",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:all-browsers": "playwright test",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:api": "playwright test --project=chromium tests/11-api.spec.ts",
    "evidencias": "EVIDENCIAS=1 playwright test --project=chromium",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:5173",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.7",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
